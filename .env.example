# Copier en .env — ne jamais committer .env
STUDIO_COUTURE_DATABASE_URL=postgres://studio:studio@localhost:5432/studio_couture
# Clé maître 32 octets en base64 (générer : openssl rand -base64 32)
STUDIO_COUTURE_PHOTO_ENCRYPTION_KEY_BASE64=
# Rétention photos clientes (jours) — défaut produit : 7
PHOTO_RETENTION_DAYS=7
# Session
STUDIO_COUTURE_SESSION_SECRET=
PUBLIC_DEFAULT_LOCALE=fr


# Taille maximale d'une requête (adapter-node). 6M = photo de 5 Mo + marge d'envoi. Ne jamais mettre Infinity.
BODY_SIZE_LIMIT=6M
# Assistant de mod�le IA (optionnel)
STUDIO_COUTURE_IA_API_KEY=
STUDIO_COUTURE_IA_BASE_URL=
STUDIO_COUTURE_IA_MODELE=
