{
  "name": "studio-couture",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Studio Couture — SSR SvelteKit, PWA, mobile-first pour ateliers au Bénin",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.9",
    "@sveltejs/kit": "^2.15.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "svelte": "^5.16.0",
    "svelte-check": "^4.1.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=20"
  }
}
